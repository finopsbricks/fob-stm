    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": ["statements", "api-client", "cli", "finops"],
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
