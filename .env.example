# Statements credentials for direct env use (workers, or CLI without a config file).
# The CLI also reads ~/.fob-stm/config.yml; env vars (all three set) take precedence
# over the config file's current org. Note: origin-only URL — the client adds /api/v1.
FOB_STM_API_URL=https://statements.finopsbricks.com/
FOB_STM_API_KEY=fob_stm_xxxxxxxxxxxxxxxx
FOB_STM_API_SECRET=yyyyyyyyyyyyyyyyyyyy
